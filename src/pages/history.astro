---
import Base from '../layouts/Base.astro';
import FlagBadge from '../components/FlagBadge.astro';
import { loadHistory, localTime, longDate, windowsOf } from '../lib/status';

const days = loadHistory().map((day) => ({ date: day.date, windows: windowsOf(day) }));
const first = days.at(-1)?.date;

const title = 'Cappadocia balloon flight history: which days balloons flew';
const description =
  'Day-by-day record of the official Cappadocia hot air balloon flight flags, sector by sector, as published by the Slot Service Center.';
---

<Base
  title={title}
  description={description}
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Today', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'History', item: new URL('/history/', Astro.site).href },
      ],
    },
  ]}
>
  <h1>Flight history</h1>
  <p>
    Every flag change recorded by this site, newest first. Times are Türkiye time.
    {first && <> Records start on {longDate(first)}; windows before the first check of a day are not included.</>}
  </p>

  {
    days.length === 0 ? (
      <p class="muted">Nothing recorded yet.</p>
    ) : (
      days.map(({ date, windows }) => (
        <section class="card day">
          <h2>{longDate(date)}</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Window</th>
                  <th scope="col">Sector A</th>
                  <th scope="col">Sector B</th>
                  <th scope="col">Sector C</th>
                </tr>
              </thead>
              <tbody>
                {windows.map(({ window, flags }) => (
                  <tr>
                    <td>
                      {localTime(window.start)}–{localTime(window.end)}
                    </td>
                    {['A', 'B', 'C'].map((id) => (
                      <td>{flags.has(id) ? <FlagBadge flag={flags.get(id)!} /> : '–'}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))
    )
  }
</Base>

<style>
  .day {
    margin-top: 1rem;
  }

  .day h2 {
    margin-top: 0;
  }
</style>
