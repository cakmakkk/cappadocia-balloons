---
import { messages } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import type { Flag } from '../lib/status.ts';

interface Props {
  locale: Locale;
  flag: Flag;
}

const { locale, flag } = Astro.props;
---

<span class={`flag flag-${flag}`}>{messages(locale).flag[flag]}</span>
