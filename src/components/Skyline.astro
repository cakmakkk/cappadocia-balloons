---
// The hero illustration: fairy chimneys at dawn. Balloons are up when they
// may fly, resting on the ground when they can't, and the valley is dark
// before the morning decision.

import type { Scene } from '../lib/status.ts';

interface Props {
  scene: Scene;
}

const { scene } = Astro.props;

const PALETTES = {
  flying: { far: '#d9b3a6', mid: '#c4876a', front: '#99583f', cap: '#6b3f31', window: '#5a3326' },
  grounded: { far: '#bdb1b0', mid: '#a58979', front: '#84604f', cap: '#5f4a40', window: '#4f3a31' },
  night: { far: '#3a3561', mid: '#2a2547', front: '#1b1830', cap: '#110e22', window: '#ffcf7a' },
};
const colors = PALETTES[scene];

// Same "random" stars on every build.
function seeded(seed: number) {
  return () => {
    seed = (seed * 16807) % 2147483647;
    return (seed - 1) / 2147483646;
  };
}

/** A soft cone with a darker basalt cap on top. */
function chimney(x: number, base: number, height: number, width: number) {
  const top = base - height;
  const body =
    `M${x - width / 2},${base} ` +
    `C${x - width * 0.42},${base - height * 0.55} ${x - width * 0.16},${top + height * 0.12} ${x - width * 0.1},${top} ` +
    `L${x + width * 0.1},${top} ` +
    `C${x + width * 0.16},${top + height * 0.12} ${x + width * 0.42},${base - height * 0.55} ${x + width / 2},${base} Z`;
  return { body, cap: { cx: x, cy: top + 2, rx: width * 0.2, ry: width * 0.09 }, x, top, height, width };
}

const midChimneys = [
  [90, 92, 44], [150, 122, 52], [205, 72, 36], [470, 100, 46], [522, 142, 56],
  [577, 86, 40], [880, 112, 50], [940, 152, 60], [1000, 90, 42], [1130, 96, 46],
].map(([x, h, w]) => chimney(x, 350, h, w));

const frontChimneys = [
  [34, 124, 62], [300, 92, 50], [344, 134, 62], [700, 104, 54], [758, 72, 40], [1062, 124, 58], [1170, 86, 44],
].map(([x, h, w]) => chimney(x, 394, h, w));

// Cave windows cut into the front chimneys.
const windows = frontChimneys.flatMap((c, i) =>
  [0.45, 0.68].slice(0, c.height > 100 ? 2 : 1).map((at, j) => ({
    x: c.x + (j % 2 === 0 ? -1 : 1) * c.width * 0.08 - 3,
    y: c.top + c.height * at,
    key: `${i}-${j}`,
  })),
);

const BALLOON_COLORS = [
  ['#c4583a', '#f0a07a'],
  ['#d9a03f', '#f6d38a'],
  ['#3f8f8a', '#9fd1c6'],
  ['#cf6f86', '#f3b5c2'],
  ['#ef9a62', '#fbd2ad'],
  ['#7b5c8f', '#c6add6'],
];

const flyingBalloons = [
  [262, 122, 1.25, 0], [432, 72, 0.8, 1], [642, 150, 1.05, 2], [762, 62, 0.65, 3],
  [982, 112, 0.95, 4], [152, 214, 0.6, 5], [1110, 196, 0.7, 2],
].map(([x, y, scale, color], i) => ({ x, y, scale, color: BALLOON_COLORS[color], delay: (i * 1.3) % 5 }));

const restingBalloons = [
  [418, 386, 0], [652, 382, 2], [912, 388, 4],
].map(([x, y, color]) => ({ x, y, color: BALLOON_COLORS[color] }));

const random = seeded(7);
const stars = Array.from({ length: 70 }, (_, i) => ({
  x: Math.round(random() * 1200),
  y: Math.round(random() * 250),
  r: random() > 0.85 ? 1.8 : 1,
  delay: Math.round(random() * 40) / 10,
  key: i,
}));

const windStreaks = [
  'M-40,96 C160,78 320,110 520,92',
  'M300,168 C480,150 640,182 860,160',
  'M620,72 C800,56 960,86 1240,64',
  'M80,250 C260,232 420,262 640,244',
];
---

<svg
  class={`skyline scene-${scene}`}
  viewBox="0 0 1200 420"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="sky-flying" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b8c4e6" />
      <stop offset="0.45" stop-color="#efc6c4" />
      <stop offset="0.8" stop-color="#fad6a8" />
    </linearGradient>
    <linearGradient id="sky-grounded" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#a9b2c4" />
      <stop offset="0.5" stop-color="#cfc2c4" />
      <stop offset="0.85" stop-color="#e6d3c2" />
    </linearGradient>
    <linearGradient id="sky-night" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#121834" />
      <stop offset="0.55" stop-color="#2b2b57" />
      <stop offset="0.85" stop-color="#5d466c" />
      <stop offset="1" stop-color="#8a5b6a" />
    </linearGradient>
    <radialGradient id="sun-glow">
      <stop offset="0" stop-color="#fff1c9" stop-opacity="0.95" />
      <stop offset="0.35" stop-color="#ffd59a" stop-opacity="0.6" />
      <stop offset="1" stop-color="#ffd59a" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1200" height="420" fill={`url(#sky-${scene})`} />

  {
    scene === 'night' ? (
      <g class="stars">
        {stars.map((s) => (
          <circle cx={s.x} cy={s.y} r={s.r} fill="#fff7e6" style={`animation-delay:${s.delay}s`} />
        ))}
        <path d="M1002,58 a26,26 0 1,0 18,46 a22,22 0 1,1 -18,-46 z" fill="#fbe9c4" opacity="0.9" />
      </g>
    ) : (
      <g>
        <circle cx="928" cy="292" r="150" fill="url(#sun-glow)" />
        <circle cx="928" cy="292" r="40" fill={scene === 'flying' ? '#ffe2a8' : '#f3e2c9'} />
      </g>
    )
  }

  {
    scene === 'grounded' && (
      <g class="wind" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.55">
        {windStreaks.map((d, i) => (
          <path d={d} style={`animation-delay:${i * 0.9}s`} />
        ))}
      </g>
    )
  }

  <path
    d="M0,300 C150,270 260,292 380,280 C520,266 640,302 780,286 C900,272 1040,294 1200,278 L1200,420 L0,420 Z"
    fill={colors.far}
  />

  {
    scene === 'flying' && (
      <g class="balloons">
        {flyingBalloons.map((b) => (
          <g transform={`translate(${b.x} ${b.y}) scale(${b.scale})`}>
            <g class="float" style={`animation-delay:-${b.delay}s`}>
              <path
                d="M0,-36 C20,-36 32,-22 32,-6 C32,10 18,20 9,30 L-9,30 C-18,20 -32,10 -32,-6 C-32,-22 -20,-36 0,-36 Z"
                fill={b.color[0]}
              />
              <path
                d="M0,-36 C9,-36 13,-20 13,-6 C13,10 7,20 4,30 L-4,30 C-7,20 -13,10 -13,-6 C-13,-20 -9,-36 0,-36 Z"
                fill={b.color[1]}
              />
              <path d="M-9,30 L-6,39 M9,30 L6,39" stroke="#5a3a2a" stroke-width="1.2" />
              <rect x="-7" y="39" width="14" height="10" rx="2" fill="#6b4230" />
            </g>
          </g>
        ))}
      </g>
    )
  }

  <path
    d="M0,352 C200,336 420,354 640,340 C860,328 1020,352 1200,338 L1200,420 L0,420 Z"
    fill={colors.mid}
  />
  {
    midChimneys.map((c) => (
      <g>
        <path d={c.body} fill={colors.mid} />
        <ellipse {...c.cap} fill={colors.cap} />
      </g>
    ))
  }

  <path
    d="M0,394 C240,380 480,400 720,386 C930,374 1080,394 1200,384 L1200,420 L0,420 Z"
    fill={colors.front}
  />
  {
    frontChimneys.map((c) => (
      <g>
        <path d={c.body} fill={colors.front} />
        <ellipse {...c.cap} fill={colors.cap} />
      </g>
    ))
  }
  {
    windows.map((w) => (
      <path
        d={`M${w.x},${w.y + 9} v-5 a3,3 0 0,1 6,0 v5 z`}
        fill={colors.window}
        class={scene === 'night' ? 'lit' : undefined}
      />
    ))
  }

  {
    scene !== 'flying' &&
      restingBalloons.map((b) => (
        <g transform={`translate(${b.x} ${b.y})`} opacity={scene === 'night' ? 0.45 : 1}>
          <ellipse cx="-14" cy="-6" rx="38" ry="9" fill={b.color[0]} />
          <path d="M-52,-6 C-40,-14 -20,-15 -2,-12 L-2,0 C-20,2 -40,1 -52,-6 Z" fill={b.color[1]} opacity="0.7" />
          <rect x="26" y="-13" width="14" height="12" rx="2" fill="#6b4230" />
        </g>
      ))
  }
</svg>

<style>
  .skyline {
    display: block;
    width: 100%;
    height: clamp(250px, 40vw, 430px);
  }

  .float {
    animation: float 9s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  .stars circle {
    animation: twinkle 4s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.9;
    }
    50% {
      opacity: 0.35;
    }
  }

  .wind path {
    stroke-dasharray: 120 520;
    animation: gust 4.5s linear infinite;
  }

  @keyframes gust {
    from {
      stroke-dashoffset: 640;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float,
    .stars circle,
    .wind path {
      animation: none;
    }
  }
</style>
