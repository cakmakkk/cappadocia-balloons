---
import { list, time, timeRange } from '../i18n/format.ts';
import { messages } from '../i18n/index.ts';
import { localeInfo, type Locale } from '../i18n/locales.ts';
import type { HomeState } from '../lib/status.ts';

interface Props {
  locale: Locale;
  state: HomeState;
  checkedAt: string | null;
  sunrise: string;
}

const { locale, state, checkedAt, sunrise } = Astro.props;
const t = messages(locale);
const s = t.home.status;

const range = (w: { start: string; end: string }) => timeRange(locale, w.start, w.end);
const areas = (green: string[]) => (green.length === 3 ? t.areas.all : t.areas.some(list(locale, green), green.length));

let tone: 'go' | 'stop' | 'wait';
let headline: string;
let detail: string;
let later: string | null = null;

switch (state.kind) {
  case 'flying-now':
    [tone, headline, detail] = ['go', s.flyingNow.headline, s.flyingNow.detail(areas(state.green), range(state.window))];
    break;
  case 'grounded-now':
    [tone, headline, detail] = ['stop', s.groundedNow.headline, s.groundedNow.detail(range(state.window))];
    break;
  case 'flew-this-morning':
    [tone, headline, detail] = ['go', s.flewThisMorning.headline, s.flewThisMorning.detail(areas(state.green), range(state.window))];
    break;
  case 'grounded-this-morning':
    [tone, headline, detail] = ['stop', s.groundedThisMorning.headline, s.groundedThisMorning.detail(range(state.window))];
    break;
  case 'morning-not-recorded':
    [tone, headline, detail] = ['wait', s.morningNotRecorded.headline, s.morningNotRecorded.detail];
    break;
  case 'waiting':
    [tone, headline, detail] = ['wait', s.waiting.headline, s.waiting.detail(time(locale, sunrise))];
    break;
  default:
    [tone, headline, detail] = ['wait', s.noData.headline, s.noData.detail];
}

if ((state.kind === 'flew-this-morning' || state.kind === 'grounded-this-morning' || state.kind === 'morning-not-recorded') && state.later) {
  later = t.home.laterWindow(range(state.later.window), state.later.green.length > 0);
}
---

<section class={`status status-${tone}`} aria-live="polite">
  <p class="headline">{headline}</p>
  <p class="detail">{detail}</p>
  {later && <p class="later">{later}</p>}
  <p class="meta">
    <span>{t.home.sunrise(time(locale, sunrise))}</span>
    {
      checkedAt && (
        <span data-checked-at={checkedAt} data-locale={localeInfo(locale).intl} data-stale={t.home.stale}>
          {t.home.checkedAt(time(locale, checkedAt))}
          <span class="ago" />
        </span>
      )
    }
    <span>{t.turkeyTime}</span>
  </p>
</section>

<script>
  // "12 minutes ago" in the page's language, and a warning when the page is clearly stale.
  const el = document.querySelector<HTMLElement>('[data-checked-at]');
  const ago = el?.querySelector('.ago');
  if (el && ago) {
    const minutes = Math.round((Date.now() - Date.parse(el.dataset.checkedAt!)) / 60000);
    if (minutes > 120) {
      ago.textContent = ` · ${el.dataset.stale}`;
      el.classList.add('is-stale');
    } else {
      const rtf = new Intl.RelativeTimeFormat(el.dataset.locale, { numeric: 'auto' });
      ago.textContent = ` (${rtf.format(-Math.max(minutes, 0), 'minute')})`;
    }
  }
</script>

<style>
  .status {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 6px solid var(--line);
    border-radius: 18px;
    padding: 1.25rem 1.25rem 1rem;
    box-shadow: 0 18px 40px rgb(43 33 24 / 0.1);
  }

  .status-go {
    border-top-color: var(--go);
  }

  .status-stop {
    border-top-color: var(--stop);
  }

  .status-wait {
    border-top-color: var(--hold);
  }

  .status p {
    margin: 0.3rem 0;
  }

  .headline {
    font: 600 clamp(1.4rem, 4.5vw, 1.9rem) / 1.2 var(--font-display);
  }

  .status-go .headline {
    color: var(--go);
  }

  .status-stop .headline {
    color: var(--stop);
  }

  .detail {
    font-size: 1.05rem;
  }

  .later {
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem !important;
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(.is-stale) {
    color: var(--stop);
  }
</style>
