---
import { time, timeRange } from '../i18n/format.ts';
import { messages } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import { describe } from '../lib/describe.ts';
import { SOURCE_URL, type HomeState, type OfficialUpdate } from '../lib/status.ts';

interface Props {
  locale: Locale;
  state: HomeState;
  checkedAt: string | null;
  sunrise: string;
  /** Today's decisions, oldest first. */
  updates: OfficialUpdate[];
}

const { locale, state, checkedAt, sunrise, updates } = Astro.props;
const t = messages(locale);
const range = (w: { start: string; end: string }) => timeRange(locale, w.start, w.end);
const { tone, headline, detail, later } = describe(locale, state, sunrise);
---

<section class={`status status-${tone}`} aria-live="polite">
  <p class="eyebrow">{t.home.quickAnswer}</p>
  <p class="headline">
    <span class="signal" aria-hidden="true"></span>
    {headline}
  </p>
  <p class="detail">{detail}</p>
  {later && <p class="later">{later}</p>}

  {
    updates.length > 0 && (
      <div class="timeline">
        <p class="timeline-title">{t.home.timelineTitle}</p>
        <ol>
          {updates.map((update) => (
            <li>
              <span class="when">{time(locale, update.at)}</span>
              <span class="flags">
                {update.flags.map(({ id, flag }) => (
                  <span class={`chip chip-${flag}`} title={`${t.sector(id)}: ${t.flag[flag]}`}>
                    {id}
                    <span class="visually-hidden">{` ${t.flag[flag]}`}</span>
                  </span>
                ))}
              </span>
              {update.window && <span class="window">{range(update.window)}</span>}
            </li>
          ))}
        </ol>
      </div>
    )
  }

  <p class="meta">
    <span>{t.home.sunrise(time(locale, sunrise))}</span>
    {
      checkedAt && (
        <span data-checked-at={checkedAt} data-stale={t.home.stale}>
          {t.home.checkedAt(time(locale, checkedAt))}
        </span>
      )
    }
    <span>{t.turkeyTime}</span>
    <a href={SOURCE_URL} rel="nofollow">{t.home.source}</a>
  </p>
</section>

<script>
  // Warn when the page is clearly stale. Only then does the card change after
  // load, so a fresh page never shifts.
  const el = document.querySelector<HTMLElement>('[data-checked-at]');
  if (el && Date.now() - Date.parse(el.dataset.checkedAt!) > 120 * 60_000) {
    el.textContent += ` · ${el.dataset.stale}`;
    el.classList.add('is-stale');
  }
</script>

<style>
  .status {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.25rem 1.25rem 1rem;
    box-shadow: 0 12px 32px rgb(20 16 12 / 0.12);
  }

  .status p {
    margin: 0.3rem 0;
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .headline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: 700 clamp(1.35rem, 4.6vw, 1.75rem) / 1.25 var(--font-display);
    letter-spacing: -0.01em;
  }

  .signal {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--hold);
    box-shadow: 0 0 0 5px var(--hold-bg);
  }

  .status-go .signal {
    background: var(--go);
    box-shadow: 0 0 0 5px var(--go-bg);
  }

  .status-stop .signal {
    background: var(--stop);
    box-shadow: 0 0 0 5px var(--stop-bg);
  }

  .detail {
    font-size: 1.04rem;
  }

  .later {
    color: var(--muted);
  }

  .timeline {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .timeline-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }

  .timeline ol {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .timeline li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .when {
    font-weight: 700;
    min-width: 3rem;
  }

  .flags {
    display: inline-flex;
    gap: 0.25rem;
  }

  .chip {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: var(--muted);
  }

  .chip-green {
    background: var(--go);
  }

  .chip-yellow {
    background: var(--hold);
  }

  .chip-red {
    background: var(--stop);
  }

  .window {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.9rem !important;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.86rem;
  }

  .meta a {
    color: var(--muted);
  }

  :global(.is-stale) {
    color: var(--stop);
  }
</style>
