---
import { Font } from 'astro:assets';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { messages } from '../i18n/index.ts';
import { DEFAULT_LOCALE, LOCALES, localeInfo, type Locale } from '../i18n/locales.ts';
import { absolute, alternates, asset, href } from '../lib/paths.ts';
import { SOURCE_URL } from '../lib/status.ts';

interface Props {
  locale: Locale;
  /** The page without its language prefix, e.g. "/history/". */
  path: string;
  title: string;
  description: string;
  /** For social shares, which outlive today's status; defaults to `description`. */
  ogDescription?: string;
  /** Extra JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  /** Pages like 404 have no language versions. */
  standalone?: boolean;
}

const { locale, path, title, description, ogDescription = description, structuredData = [], standalone = false } = Astro.props;
const t = messages(locale);
const info = localeInfo(locale);
const canonical = absolute(locale, path, Astro.site);
const languageVersions = alternates(path, Astro.site);
// Pages without language versions send language links to each language's home page.
const switchPath = standalone ? '/' : path;

const nav = [
  { path: '/', label: t.nav.today },
  { path: '/tomorrow/', label: t.nav.tomorrow },
  { path: '/history/', label: t.nav.history },
  { path: '/guides/', label: t.nav.guides },
  { path: '/about/', label: t.nav.about },
];
const isCurrent = (navPath: string) => (navPath === '/' ? path === '/' : path.startsWith(navPath));

// Each language's own invitation to switch, for the hint banner.
const hints = Object.fromEntries(
  LOCALES.map((l) => [l.code, { url: href(l.code, switchPath), text: messages(l.code).langHint, close: messages(l.code).dismiss }]),
);

const verification = {
  'google-site-verification': import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION,
  'msvalidate.01': import.meta.env.PUBLIC_BING_SITE_VERIFICATION,
  'naver-site-verification': import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION,
  'yandex-verification': import.meta.env.PUBLIC_YANDEX_VERIFICATION,
};

const ogImage = new URL(asset('/og.jpg'), Astro.site).href;

// Inter files worth preloading for this language; Korean, Japanese and Chinese use system fonts.
const FONT_SUBSETS: Partial<Record<Locale, string[]>> = { ru: ['cyrillic'] };
const fontSubsets = ['ko', 'ja', 'zh'].includes(locale) ? [] : (FONT_SUBSETS[locale] ?? ['latin']);
---

<!doctype html>
<html lang={info.hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fontSubsets.length > 0 ? <Font cssVariable="--font-inter" preload={fontSubsets.map((subset) => ({ subset }))} /> : <Font cssVariable="--font-inter" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    {
      !standalone && (
        <>
          {languageVersions.map(({ locale: l, url }) => (
            <link rel="alternate" hreflang={l.hreflang} href={url} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LOCALE, path, Astro.site)} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={asset('/icon-192.png')} />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/manifest.webmanifest')} />
    <link rel="sitemap" href={asset('/sitemap.xml')} />
    <meta name="theme-color" content="#f6f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={info.og} />
    {!standalone && LOCALES.filter((l) => l.code !== locale).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {Object.entries(verification).map(([name, content]) => content && <meta name={name} content={content} />)}
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <div class="lang-hint" hidden data-hints={JSON.stringify(hints)} data-current={locale}>
      <a href="#"></a>
      <button type="button"></button>
    </div>

    <header class="site-header">
      <div class="header-top">
        <a class="brand" href={href(locale, '/')}>
          <img src={asset('/favicon.svg')} alt="" width="28" height="28" />
          {t.siteName}
        </a>
        <LanguageSwitcher locale={locale} path={switchPath} />
      </div>
      <nav aria-label={t.siteName}>
        {nav.map((item) => (
          <a href={href(locale, item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>

    <slot name="hero" />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-nav">
          {nav.map((item) => <a href={href(locale, item.path)}>{item.label}</a>)}
        </p>
        <nav class="footer-langs" aria-label={t.footer.languages}>
          <span>{t.footer.languages}:</span>
          {
            LOCALES.filter((l) => l.code !== locale).map((l) => (
              <a href={href(l.code, switchPath)} hreflang={l.hreflang} lang={l.hreflang}>
                {l.name}
              </a>
            ))
          }
        </nav>
        <p>{t.footer.independent}</p>
        <p class="footer-links">
          <a href={SOURCE_URL} rel="nofollow">{t.footer.source}</a>
          <a href="https://github.com/cakmakkk/cappadocia-balloons/tree/main/data">{t.footer.data}</a>
        </p>
      </div>
    </footer>

    <script>
      // Offer the visitor's own language once, without redirecting anyone.
      const hint = document.querySelector<HTMLElement>('.lang-hint');
      const KEY = 'lang-hint-dismissed';
      let dismissed = false;
      try {
        dismissed = localStorage.getItem(KEY) === '1';
      } catch {}
      if (hint && !dismissed) {
        const hints = JSON.parse(hint.dataset.hints!) as Record<string, { url: string; text: string; close: string }>;
        const preferred = navigator.languages.map((l) => l.toLowerCase().split('-')[0]).find((code) => code in hints);
        if (preferred && preferred !== hint.dataset.current) {
          const link = hint.querySelector('a')!;
          const button = hint.querySelector('button')!;
          link.href = hints[preferred].url;
          link.textContent = `${hints[preferred].text} →`;
          button.textContent = '×';
          button.setAttribute('aria-label', hints[preferred].close);
          button.addEventListener('click', () => {
            hint.hidden = true;
            try {
              localStorage.setItem(KEY, '1');
            } catch {}
          });
          hint.hidden = false;
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f4f1;
    --surface: #ffffff;
    --ink: #1d1a17;
    --muted: #6a635b;
    --line: #e6e1da;
    --accent: #a8451f;
    --go: #126b33;
    --go-bg: #e3f4e9;
    --hold: #9a5b00;
    --hold-bg: #fcefd8;
    --stop: #b42318;
    --stop-bg: #fde9e7;
    --font-display: var(--font-inter);
    --font-body: var(--font-inter);
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #121110;
      --surface: #1b1a18;
      --ink: #f2efea;
      --muted: #a9a29a;
      --line: #2e2b28;
      --accent: #f08a5d;
      --go: #5fd08a;
      --go-bg: #15301f;
      --hold: #f2b84b;
      --hold-bg: #382a10;
      --stop: #ff8a7a;
      --stop-bg: #3a1a17;
      color-scheme: dark;
    }
  }

  :root[data-theme='dark'] {
    --bg: #121110;
    --surface: #1b1a18;
    --ink: #f2efea;
    --muted: #a9a29a;
    --line: #2e2b28;
    --accent: #f08a5d;
    --go: #5fd08a;
    --go-bg: #15301f;
    --hold: #f2b84b;
    --hold-bg: #382a10;
    --stop: #ff8a7a;
    --stop-bg: #3a1a17;
    color-scheme: dark;
  }

  /* Korean, Japanese and Chinese use the system's own fonts. */
  :root:lang(ko),
  :root:lang(ja),
  :root:lang(zh-Hans) {
    --font-body: system-ui, -apple-system, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Hiragino Sans', 'Yu Gothic UI',
      'PingFang SC', 'Microsoft YaHei', sans-serif;
    --font-display: var(--font-body);
  }

  /* Korean breaks lines between words, not inside them. */
  :root:lang(ko) {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 17px/1.65 var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
  }

  main,
  .site-header,
  .footer-inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 16px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  h1 {
    font-size: clamp(1.85rem, 6vw, 2.6rem);
    margin: 0.5rem 0 1rem;
  }

  h2 {
    font-size: 1.3rem;
    margin: 2.5rem 0 0.75rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.25rem;
  }

  .muted {
    color: var(--muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.05rem 0.6rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .flag::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: currentColor;
  }

  .flag-green {
    color: var(--go);
    background: var(--go-bg);
  }

  .flag-yellow {
    color: var(--hold);
    background: var(--hold-bg);
  }

  .flag-red {
    color: var(--stop);
    background: var(--stop-bg);
  }

  .flag-unknown {
    color: var(--muted);
    background: var(--line);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    text-align: left;
    padding: 0.55rem 0.5rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .table-wrap {
    overflow-x: auto;
  }

  /* Floats over the page instead of pushing it down when it appears. */
  .lang-hint {
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 32px);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.95rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
  }

  .lang-hint[hidden] {
    display: none;
  }

  .lang-hint a {
    color: inherit;
    font-weight: 600;
  }

  .lang-hint button {
    border: 0;
    background: none;
    color: inherit;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  .site-header {
    padding-top: 1rem;
    padding-bottom: 0.75rem;
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font: 600 1.1rem/1.2 var(--font-display);
    color: var(--ink);
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: 0.25rem 1.1rem;
    margin-top: 0.6rem;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.97rem;
  }

  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
  }

  .site-header nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .site-footer {
    margin-top: 4rem;
    color: var(--muted);
    font-size: 0.88rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-inner {
    padding-top: 1.25rem;
    padding-bottom: 2.5rem;
    max-width: none;
  }

  .footer-inner p {
    max-width: 48rem;
    margin: 0.3rem auto;
  }

  .footer-links,
  .footer-nav,
  .footer-langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    max-width: 48rem;
    margin: 0.3rem auto;
  }

  .footer-nav {
    margin-bottom: 0.9rem;
    font-weight: 600;
  }

  .footer-nav a {
    color: var(--ink);
    text-decoration: none;
  }

  .footer-langs {
    gap: 0.25rem 0.9rem;
    margin-bottom: 0.9rem;
  }

  .footer-langs a {
    color: var(--muted);
  }

  .footer-links a {
    color: var(--ink);
  }
</style>
