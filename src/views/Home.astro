---
import DayStrip from '../components/DayStrip.astro';
import FlagBadge from '../components/FlagBadge.astro';
import ForecastCard from '../components/ForecastCard.astro';
import { Picture } from 'astro:assets';
import SectorMap from '../components/SectorMap.astro';
import StatusCard from '../components/StatusCard.astro';
import { PHOTOS } from '../data/photos.ts';
import { longDate, timeRange } from '../i18n/format.ts';
import { messages } from '../i18n/index.ts';
import { localeInfo, type Locale } from '../i18n/locales.ts';
import Base from '../layouts/Base.astro';
import { describe } from '../lib/describe.ts';
import { docsIn, slugOf } from '../lib/docs.ts';
import { loadForecast } from '../lib/forecast.ts';
import { absolute, href } from '../lib/paths.ts';
import { homeState, loadHistory, loadLatest, localDate, officialUpdates, outcomeOf, sceneOf } from '../lib/status.ts';
import { sunriseOn } from '../lib/sun.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);

const now = new Date();
const history = loadHistory();
const latest = loadLatest(history);
const state = homeState(latest, history, now);
const scene = sceneOf(state);
const photo = PHOTOS[scene];
const today = localDate(now);
const todaysUpdates = officialUpdates(history.find((day) => day.date === today) ?? { date: today, states: [] });

const mapWindow = latest?.sectors[0]?.window ?? null;
const mapFlags = Object.fromEntries((latest?.sectors ?? []).map((s) => [s.id, s.flag]));
const mapIntro =
  mapWindow &&
  (mapWindow.date === today
    ? t.home.mapIntro(timeRange(locale, mapWindow.start, mapWindow.end))
    : t.home.mapIntroEarlier(longDate(locale, mapWindow.date), timeRange(locale, mapWindow.start, mapWindow.end)));
const next = loadForecast()?.mornings.find((m) => Date.parse(m.window.start) > now.getTime()) ?? null;
const recent = history
  .slice(0, 14)
  .map((day) => ({ date: day.date, outcome: outcomeOf(day) }))
  .reverse();
const guides = await docsIn(locale, 'guide');

// The title carries today's date and the description today's answer, so a
// search result shows the current status before anyone clicks.
const sunrise = sunriseOn(today);
const status = describe(locale, state, sunrise);
const title = t.home.titleDated(longDate(locale, today));
const description = `${status.headline}. ${status.detail}`;

const homeUrl = absolute(locale, '/', Astro.site);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t.siteName,
    url: homeUrl,
    inLanguage: localeInfo(locale).hreflang,
    publisher: { '@type': 'Organization', name: t.siteName, url: homeUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: homeUrl,
    inLanguage: localeInfo(locale).hreflang,
    ...(latest && { dateModified: latest.checkedAt }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: localeInfo(locale).hreflang,
    mainEntity: t.home.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Base
  locale={locale}
  path="/"
  title={title}
  description={description}
  ogDescription={t.home.description}
  structuredData={structuredData}
>
  <section slot="hero" class="hero">
    <Picture
      src={photo.src}
      alt={t.photoAlt[scene]}
      widths={[640, 1024, 1440, 1800]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      class="hero-photo"
      style={`object-position: ${photo.position}`}
    />
    <div class="hero-text">
      <p class="hero-date">{longDate(locale, today)}</p>
      <h1>{t.home.h1}</h1>
    </div>
    <a class="hero-credit" href={photo.source} rel="nofollow">{t.photoCredit(photo.author, photo.license)}</a>
  </section>

  <div class="lift">
    <StatusCard
      locale={locale}
      state={state}
      checkedAt={latest?.checkedAt ?? null}
      sunrise={sunrise}
      updates={todaysUpdates}
    />
  </div>

  {
    next && (
      <section>
        <h2>{next.date === today ? t.home.thisMorningTitle : t.home.tomorrowTitle}</h2>
        <div class="card">
          <ForecastCard locale={locale} morning={next} />
          <p class="card-link">
            <a href={href(locale, '/tomorrow/')}>{t.home.tomorrowLink} →</a>
          </p>
        </div>
      </section>
    )
  }

  {
    mapWindow && (
      <section>
        <h2>{t.home.mapTitle}</h2>
        <p class="muted">{mapIntro}</p>
        <SectorMap locale={locale} flags={mapFlags} />
      </section>
    )
  }

  {
    latest && latest.secondary.length > 0 && (
      <section>
        <h2>{t.home.secondaryTitle}</h2>
        <p class="muted">{t.home.secondaryIntro}</p>
        {new Set(latest.secondary.map((area) => area.flag)).size === 1 ? (
          <p class="regions-all">
            <span>
              {t.home.regions(`${latest.secondary[0].id}–${latest.secondary.at(-1)!.id}`)}
            </span>
            <FlagBadge locale={locale} flag={latest.secondary[0].flag} />
          </p>
        ) : (
          <ul class="regions">
            {latest.secondary.map((area) => (
              <li>
                <span>{t.home.region(area.id)}</span>
                <FlagBadge locale={locale} flag={area.flag} />
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section>
        <h2>{t.home.recentTitle}</h2>
        <DayStrip locale={locale} days={recent} />
        <p class="card-link">
          <a href={href(locale, '/history/')}>{t.home.allHistory} →</a>
        </p>
      </section>
    )
  }

  <section>
    <h2>{t.home.guidesTitle}</h2>
    <ul class="guide-links">
      {
        guides.map((doc) => (
          <li>
            <a href={href(locale, `/guides/${slugOf(doc)}/`)}>{doc.data.title}</a>
            <span class="muted">{doc.data.description}</span>
          </li>
        ))
      }
    </ul>
    <p class="muted source-note">{t.home.sourceNote}</p>
  </section>

  <section class="faq">
    <h2>{t.home.faqTitle}</h2>
    {
      t.home.faq.map(({ q, a }) => (
        <div class="faq-item">
          <h3>{q}</h3>
          <p>{a}</p>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .hero {
    position: relative;
    height: clamp(300px, 46vw, 460px);
    overflow: hidden;
    background: #2a241f;
  }

  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Darken the bottom so the heading stays readable on any photo. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(12 10 8 / 0.78) 0%, rgb(12 10 8 / 0.35) 45%, rgb(12 10 8 / 0.05) 75%);
  }

  .hero-text {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 4.75rem;
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 16px;
    color: #fff;
  }

  .hero-text h1 {
    margin: 0;
    max-width: 20ch;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }

  .hero-date {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .hero-credit {
    position: absolute;
    z-index: 1;
    right: 10px;
    top: 8px;
    font-size: 0.7rem;
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.6);
  }

  .lift {
    margin-top: -3.5rem;
    position: relative;
    z-index: 2;
  }

  .card-link {
    margin: 0.75rem 0 0;
  }

  .regions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.5rem;
  }

  .regions-all {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-weight: 600;
  }

  .regions li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
  }

  .guide-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }

  .guide-links li {
    display: grid;
  }

  .guide-links a {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .source-note {
    margin-top: 1.5rem;
    font-size: 0.92rem;
  }

  .faq-item {
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
  }

  .faq-item h3 {
    margin: 0 0 0.3rem;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .faq-item p {
    margin: 0;
    color: var(--muted);
  }
</style>
