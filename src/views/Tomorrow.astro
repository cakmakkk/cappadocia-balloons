---
import ForecastCard from '../components/ForecastCard.astro';
import { fullDate, number, time } from '../i18n/format.ts';
import { messages } from '../i18n/index.ts';
import { localeInfo, type Locale } from '../i18n/locales.ts';
import Base from '../layouts/Base.astro';
import { loadForecast, loadForecastRecords, MIN_TRACK_RECORD, trackRecord } from '../lib/forecast.ts';
import { absolute, href } from '../lib/paths.ts';
import { loadHistory } from '../lib/status.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);

const forecast = loadForecast();
const records = loadForecastRecords();
const record = trackRecord(records, loadHistory());
const firstRecord = records.map((r) => r.date).sort()[0];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.nav.today, item: absolute(locale, '/', Astro.site) },
      { '@type': 'ListItem', position: 2, name: t.nav.tomorrow, item: absolute(locale, '/tomorrow/', Astro.site) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: t.tomorrow.title,
    description: t.tomorrow.description,
    inLanguage: localeInfo(locale).hreflang,
    ...(forecast && { dateModified: forecast.fetchedAt }),
  },
];
---

<Base locale={locale} path="/tomorrow/" title={t.tomorrow.title} description={t.tomorrow.description} structuredData={structuredData}>
  <h1>{t.tomorrow.h1}</h1>
  <p class="lead">{t.tomorrow.intro}</p>
  <p class="note">{t.tomorrow.notOfficial}</p>

  {
    forecast && forecast.mornings.length > 0 ? (
      <>
        <div class="card mornings">
          {forecast.mornings.map((morning) => (
            <ForecastCard locale={locale} morning={morning} />
          ))}
        </div>
        <p class="muted small">
          {t.tomorrow.updated(time(locale, forecast.fetchedAt))} ·{' '}
          <a href="https://open-meteo.com/" rel="nofollow">
            {t.tomorrow.attribution}
          </a>{' '}
          (<a href="https://creativecommons.org/licenses/by/4.0/" rel="nofollow">CC BY 4.0</a>)
        </p>
      </>
    ) : (
      <p class="card">{t.tomorrow.unavailable}</p>
    )
  }

  <h2>{t.tomorrow.howTitle}</h2>
  <p>{t.tomorrow.howText}</p>
  {
    firstRecord && (
      <p>
        {record.goodMornings >= MIN_TRACK_RECORD
          ? t.tomorrow.track(number(locale, record.flew), number(locale, record.goodMornings))
          : t.tomorrow.trackPending(fullDate(locale, firstRecord))}
      </p>
    )
  }

  <p>
    <a href={href(locale, '/')}>{t.home.h1} →</a>
  </p>
</Base>

<style>
  .lead {
    font-size: 1.1rem;
  }

  .note {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--hold-bg);
    color: var(--hold);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .mornings {
    display: grid;
    gap: 1.1rem;
    margin-top: 1rem;
  }

  .small {
    font-size: 0.88rem;
  }
</style>
